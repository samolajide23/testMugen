{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:packer",
  "installCommand": "npm install --omit=dev",
  "outputDirectory": ".",
  "cleanUrls": true,
  "functions": {
    "api/pack.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "tools/**"
    }
  },
  "headers": [
    {
      "source": "/packs/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
