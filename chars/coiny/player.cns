trigger1 = time = 0
attr = S, NA
animtype  = Medium
damage    = 20,10
guardflag = MA
pausetime = 3,3
sparkno = 1
sparkxy = -10,-60
hitsound   = s5,0+ (Random%5)
guardsound = 6,0
ground.type = High
ground.slidetime = 12
ground.hittime  = 13
ground.velocity = -2.5
air.velocity = -2.5,-4

[State 210, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

