;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, VictoryQuote]
type = VictoryQuote
trigger1 = 1
value = 1+(random%5)


[State -2, Vs. Rocky]
type = VictoryQuote
triggerall = numenemy
trigger1 = enemy,name = "Rocky"
value = 10

[State -2, Vs. Coiny]
type = VictoryQuote
triggerall = numenemy
trigger1 = enemy,name = "Firey"
value = 11

[State -2, Super finish style 1]
type = Explod
triggerall = Win && !WinTime
triggerall = NumExplod(13580) = 0
trigger1 = StateNo = [2000,2999]
trigger2 = StateNo = [3000,3999]
anim = F 40
ID = 13580
sprpriority = -3
postype = left
pos = -30,10
bindtime = -1
supermove = 1
ownpal = 1
removetime = 160
scale = 1,1.2

[State -2,AssertSpecial]
type = AssertSpecial
triggerall = 1
trigger1 = NumExplod(13580) = 1
flag = NoBarDisplay
flag2 = NoBG
flag3 = NoFG
ignorehitpause = 1

[State 1000, 1]
type = PlaySnd
trigger1 = anim = 5150
trigger1 = animelem = 3
value = 11, 1
channel = 0

[State -2, Eletric Shock]
type = PlaySnd
trigger1 = Time = 1
trigger1 = anim = 7696
value = 170,0
channel = 0

;Maria Carina Andronic basically palletteswap Camren Springer's characters again... -_-

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

; ============================================================================
; DESTROY LOST HELPERS
; If a helper somehow gets sent into a non-helper state, kill it
; ============================================================================
[State 0: Destroy Lost Helpers]
type = null;DestroySelf
triggerall = IsHelper
trigger1 = StateNo = 0

; ============================================================================
; STAND TO CROUCH
; Overrides Stand To Crouch for DrawScaling
; ============================================================================
[State 10: Scale Coiny]
type = AngleDraw
triggerall = StateNo = 10
trigger1 = 1
scale = 1.0 + 0.5/6*Time, 1.0 - 0.5/6*Time
value = 0

; ============================================================================
; CROUCHING
; Overrides Crouching for DrawScaling
; ============================================================================
[State 11: Scale Coiny]
type = AngleDraw
triggerall = StateNo = 11
trigger1 = Time > 0
scale = 1.5, 0.5
value = 0

; ============================================================================
; CROUCH STATE
; Overrides Crouch states for DrawScaling
; ============================================================================
[State ??: Scale Coiny]
type = AngleDraw
triggerall = StateNo != [10,12]
trigger1 = StateType = C
scale = 1.5, 0.5
value = 0

; ============================================================================
; CROUCH TO STAND
; Overrides Crouch To Stand for DrawScaling
; ============================================================================
[State 12: Scale Coiny]
type = AngleDraw
triggerall = StateNo = 12
trigger1 = 1
scale = 1.0 + 0.5/6*(6-Time), 1.0 - 0.5/6*(6-Time)
value = 0


[State -3, 2]
type = PlaySnd
triggerall = Time = 1
triggerall = Life
triggerall = random < 700
trigger1 = stateno = 5000 || stateno = 5020
trigger1 = anim != 5000 && anim != 5010
trigger2 = stateno = 5010
trigger2 = anim != 5020
value = 5000,0+Random%4
channel = 0
ignorehitpause = 1
volume = 255